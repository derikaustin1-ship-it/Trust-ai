APP_ENV=development
APP_NAME=TRUSTIQ AI
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./trustiq.db
JWT_SECRET_KEY=trustiq-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:5173

# AI Provider Configuration (default is 'demo' requiring no keys)
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=demo-model

# Search Provider Configuration ('disabled', 'tavily', etc.)
SEARCH_PROVIDER=disabled
SEARCH_API_KEY=

CONFIDENCE_SCORING_VERSION=1.0.0
ENABLE_DEMO_DATA=true
